<?xml version="1.0"?>

<PropertyList>

  <path>tach.ac</path>

  <animation>
    <type>rotate</type>
    <object-name>Knob</object-name>
    <property>controls/lighting/tach-light-norm</property>
    <factor>180</factor>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
    <center>
      <x-m>0.000</x-m>
      <y-m>-0.017</y-m>
      <z-m>-0.036</z-m>
    </center>
  </animation>

  <animation>
    <type>knob</type>
    <object-name>Knob</object-name>
    <visible>true</visible>
    <action>
      <name>scrollwheel</name>
      <binding>
        <command>property-adjust</command>
        <property>controls/lighting/tach-light-norm</property>
        <factor>0.1</factor>
        <min>0</min>
        <max>1.0</max>
        <wrap>false</wrap>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>tach</tooltip-id>
        <label>RPM light %1.0f%%</label>
        <mapping>percent</mapping>
        <property>controls/lighting/tach-light-norm</property>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>select</type>
    <object-name>digit1</object-name>
    <object-name>digit2</object-name>
    <object-name>digit3</object-name>
    <condition>
      <greater-than>
        <property>/systems/electrical/volts</property>
        <value>6</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit3</object-name>
    <property>/rotors/main/rpm</property>
    <step>1</step>
    <factor>0.1</factor>
    <bias>0.0001</bias>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit2</object-name>
    <property>/rotors/main/rpm</property>
    <step>10</step>
    <factor>0.01</factor>
    <bias>0.0001</bias>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit1</object-name>
    <property>/rotors/main/rpm</property>
    <step>100</step>
    <factor>0.001</factor>
    <bias>0.0001</bias>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>material</type>
    <object-name>NR</object-name>
    <object-name>NF</object-name>
    <emission>
      <red>   0.4 </red>
      <green> 0.4 </green>
      <blue>  0.4 </blue>
      <factor-prop>systems/electrical/outputs/tach-light-norm</factor-prop>
      <offset>0.3</offset>
    </emission>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>NR</object-name>
    <property>/rotors/main/rpm</property>
    <interpolation>
      <entry><ind>  0</ind><dep>0     </dep></entry>
      <entry><ind>170</ind><dep>0.0281</dep></entry>
      <entry><ind>300</ind><dep>0.1312</dep></entry>
      <entry><ind>320</ind><dep>0.1531</dep></entry>
      <entry><ind>350</ind><dep>0.1875</dep></entry>
      <entry><ind>375</ind><dep>0.2562</dep></entry>
      <entry><ind>405</ind><dep>0.3406</dep></entry>
      <entry><ind>430</ind><dep>0.4094</dep></entry>
    </interpolation>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>NF</object-name>
    <property>/engines/engine/n2-rpm</property>
    <interpolation>
      <entry><ind>    0</ind><dep>0     </dep></entry>
      <entry><ind>14670</ind><dep>0.0281</dep></entry>
      <entry><ind>25890</ind><dep>0.1312</dep></entry>
      <entry><ind>27610</ind><dep>0.1531</dep></entry>
      <entry><ind>30200</ind><dep>0.1875</dep></entry>
      <entry><ind>32360</ind><dep>0.2562</dep></entry>
      <entry><ind>34950</ind><dep>0.3406</dep></entry>
      <entry><ind>37100</ind><dep>0.4094</dep></entry>
    </interpolation>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <!-- dimming -->
  <animation>
    <type>material</type>
    <object-name>face.002</object-name>
    <object-name>Knob</object-name>
    <condition>
      <property>systems/electrical/outputs/instrument-lights-norm</property>
      <equals>
        <property>controls/lighting/instrument-lights-selection</property>
        <value>0</value>
      </equals>
    </condition>
    <emission>
      <red>   0.8 </red>
      <green> 0.8 </green>
      <blue>  1.0 </blue>
      <factor>0.5</factor>
    </emission>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face.002</object-name>
    <object-name>Knob</object-name>
    <condition>
      <greater-than>
        <property>controls/lighting/instrument-lights-selection</property>
        <value>0</value>
      </greater-than>
    </condition>
    <emission>
      <red>   0.8 </red>
      <green> 0.8 </green>
      <blue>  1.0 </blue>
      <factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
    </emission>
  </animation>
  
  <!-- Coompositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.017</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.8</r>
      <g>0.5</g>
      <b>0.5</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>6</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.1</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights-norm</property>
  </dim-factor>
 
</light>


<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
 </animation>

</PropertyList>
